# ========================================
# Application Environment Configuration
# ========================================

# =====================
# Application Settings
# =====================
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# =====================
# Database Configuration
# =====================
# MongoDB connection string
DB_DSN=mongodb://localhost:27017

# Database name
DB_NAME=user_management

# =====================
# JWT Configuration
# =====================
# Generate a secure random key with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=e94d48a8ccc782453e0c9c3164305f9926f319f90568926a3e374e628f1c5ef6

# JWT algorithm (HS256, HS384, HS512, RS256, etc.)
JWT_ALGORITHM=HS256

# Token expiration time in seconds (86400 = 24 hours)
JWT_EXPIRATION=86400

# =====================
# CORS Configuration
# =====================
# Comma-separated list of allowed origins or * for all
CORS_ALLOWED_ORIGINS=*

# =====================
# Email Configuration (Optional)
# =====================
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_username
# MAIL_PASSWORD=your_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@example.com
# MAIL_FROM_NAME="User Management"

# =====================
# Logging Configuration
# =====================
# LOG_CHANNEL=errorlog
# LOG_LEVEL=debug

# =====================
# Rate Limiting
# =====================
# RATE_LIMIT=60
# RATE_LIMIT_WINDOW=60

# =====================
# Feature Flags
# =====================
# ENABLE_REGISTRATION=true
# ENABLE_EMAIL_VERIFICATION=false
