{
    "require": {
        "php": "^8.0",
        "ext-mongodb": "^1.15.0",
        "mongodb/mongodb": "^1.15.0",
        "vlucas/phpdotenv": "^5.5",
        "firebase/php-jwt": "^6.4",
        "slim/slim": "^4.11",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "nyholm/psr7": "^1.5",
        "nyholm/psr7-server": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 0,
        "platform": {
            "ext-mongodb": "1.15.0",
            "php": "8.0.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
